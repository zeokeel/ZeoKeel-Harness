# ============================================================
# ZeoKeel Harness 服务端部署配置样例
# 用法: cp .env.example .env 然后只改「① 必填」四项(务必改密码!)
# 完整步骤(首次部署/升级/回滚/排障)见仓库里的 docs/deploy/AI-DEPLOY.md
# 与 server/docs/DEPLOY.md(**没有**安装脚本/部署脚本:2026-09-10 起已全部移除,
# 交付物=一个镜像;证书自签等步骤由运维按文档手工执行)
# ============================================================
#
# 2026-10-23 起的口径: **新部署只需要「① 必填」里的 4 个键**。
#
# 其余运行期配置(登录失败上限 / 遥测限流 / 审计链间隔 / 应用平台档位与保留名 /
# 更新清单地址 / OIDC 回跳信任主机 / 每用户并发上限 ...)都在服务端控制台
# 「系统配置」页里改:
#   · 保存即生效(该页每个键都标了生效时机);
#   · 标注「需重启/重建容器」的键,下一次 `docker compose up -d server` 后生效;
#   · 新部署**不需要**把它们写进 .env —— 默认值合理,控制台随时可改。
#
# 为什么 .env 变短了: 容器里的环境变量是**启动期快照**,改一条限流也要重建容器;
# 而控制台看不到它们。现在这些键存在数据库里,服务端启动时读 env 作为**覆盖**
# (优先级: 显式 env > 控制台 > 默认),被 env 覆盖的键会在启动日志里点名列出 ——
# 「我先前的 .env 还在生效,控制台改了没反应」永远带线索。
# 兼容存量部署的 env 覆盖口清单见「② 历史覆盖口」。

# ------------------------------------------------------------
# ① 必填(4 个)
# ------------------------------------------------------------

# 对外域名或 IP(员工访问的地址,如 harness.example.com 或 10.0.0.5)
DOMAIN=harness.example.com

# 证书模式(三选一,重要):
#   internal = 本地自签: Caddy 本地 CA 签发(tls internal),纯内网/无公网域名开箱即用
#   auto     = 自动证书: Caddy 自动申请/续期 Let's Encrypt(需公网域名**直连**本机,
#              80/443 对外开放;域名经 CDN 时 HTTP-01 校验会失败 ⇒ 改用 manual)
#   manual   = 手动证书: 使用 certs/server.crt + certs/server.key(没有正式证书时先自己
#              用 openssl 生成自签占位,命令见 docs/deploy/AI-DEPLOY.md §4.4;
#              正式证书替换:覆盖 certs/ 下两文件 → docker compose restart caddy)
# 判断方法: 域名解析到公网且能直连 → auto;否则 → internal。auto 模式不接受 IP。
TLS_MODE=manual

# 初始管理员密码(首次启动创建 admin;已有 admin 后幂等跳过,可置空清除明文)
ZEOKEEL_ADMIN_PASSWORD=change-me-to-a-strong-password

# 内置 PostgreSQL 容器密码(首次部署时创建;请改成强密码)
PG_PASSWORD=change-me-to-a-strong-password

# ------------------------------------------------------------
# ② 历史覆盖口(可选;**新部署不需要设置**)
# ------------------------------------------------------------
#
# 下面这些键已迁移到控制台「系统配置」页。这里列出的 env 名是**兼容存量部署**的
# 覆盖口: 写了(非空)仍然生效,并且**压过控制台保存的值**(启动日志会点名被覆盖的键)。
#
#   · 存量 .env 里的旧行可以继续用,行为与升级前一致;
#   · 新部署不要再写 —— 改配置请走控制台,别把"启动期快照"再变回唯一入口;
#   · 每一项的中文名/说明/取值域都在控制台页面里,本文不展开调优教程。
#
# 12 个键(env 名 ←→ 控制台的 settings 键),按控制台分组:
#
#   认证与安全
#     ZEOKEEL_LOGIN_MAX_ATTEMPTS             auth.login_max_attempts
#     ZEOKEEL_LDAP_ALLOW_PLAINTEXT           auth.ldap_allow_plaintext
#   对外地址与更新
#     ZEOKEEL_UPDATE_ENDPOINT                deploy.update_endpoint
#   网络与反代
#     ZEOKEEL_TRUSTED_HOSTS                  deploy.trusted_hosts
#   AI 网关
#     ZEOKEEL_GATEWAY_MAX_INFLIGHT_PER_USER  gateway.max_inflight_per_user
#   遥测
#     ZEOKEEL_TELEMETRY_MAX_PER_MIN          telemetry.max_per_min
#     ZEOKEEL_TELEMETRY_MAX_PER_SKILL_PER_MIN     telemetry.max_per_skill_per_min
#     ZEOKEEL_TELEMETRY_ERROR_REPORTING_MAX_PER_MIN telemetry.error_reporting_max_per_min
#   审计
#     ZEOKEEL_AUDIT_CHAIN_INTERVAL           audit.chain_interval
#   应用平台
#     ZEOKEEL_APPS_EXTRA_RESERVED            wasm.apps_extra_reserved
#     ZEOKEEL_WASM_MEMORY_PROFILE            wasm.memory_profile
#     ZEOKEEL_COMPILE_ISOLATION              wasm.compile_isolation
#
# ⚠ 唯一需要 env 的场景(逃生口): **可用内存 < 4 GiB 的机器**若容器反复重启、
#   日志是 `WASM 应用平台启动自检失败：…超过可用内存的安全水位，拒绝启动`,
#   说明档位取大了 —— 此时还没有控制台可进,只能用 env 临时指定小档位把服务拉起来,
#   进控制台「系统配置」把它存成 small 之后**删掉这一行**:
#   ZEOKEEL_WASM_MEMORY_PROFILE=small
#
# 判据: 这些键必须继续留在 docker-compose.yml 的 server.environment 里 —— 删掉任何
#   一行都会让存量 .env 静默失效。见 server/cmd/server/compose_env_test.go 里针对
#   历史覆盖口的判据(compose 接线 + 本清单)。

# ------------------------------------------------------------
# ③ 仍留在环境变量的部署旋钮(**不入库**,理由见
#    docs/decisions/2026-10-23-db-backed-deployment-config.md「不可入库清单」)
# ------------------------------------------------------------

# 服务端镜像标签(可选)。镜像从更新服务器下载(zip → docker load),不经镜像仓库;
# 官方发布包两种 tag 都带(2.7.0 / v2.7.0),升级时按部署说明改成目标版本。
# SERVER_IMAGE=zeokeel-harness-server:2.7.0

# 私有网段与容器固定 IP(与宿主机其他网段冲突时改这里)
# NETWORK_SUBNET=172.28.0.0/24
# CADDY_IP=172.28.0.2
# SERVER_IP=172.28.0.3
# PG_IP=172.28.0.4

# 可信反向代理。**留空 = 从上面的 CADDY_IP 派生**(改网段只改一处,两者不会漂移);
# 只有宿主机另有反代(共享 Caddy/nginx)时才写它连过来的地址(通常是 docker 网桥网关)。
# ZEOKEEL_TRUSTED_PROXIES=172.20.0.1

# Caddy 宿主机端口映射(改端口时需同步修改 Caddyfile;一般不用动)
# CADDY_HTTP_PORT=80
# CADDY_HTTPS_PORT=443

# 时区(日志与"按本地日"的账本口径都从这里来)
# TZ=Asia/Shanghai

# 本服务端对外可达地址(如 https://harness.example.com)。
# **首选在控制台「网关」页填写「对外访问地址」**(settings server.base_url);这里设置时
# env 优先(兼容存量部署)。为什么重要见 docs/deploy/AI-DEPLOY.md §2.2。
# ZEOKEEL_PUBLIC_BASE_URL=https://harness.example.com

# 本部署所属渠道。**留空即可**:渠道由镜像自带的声明决定,填了必须与镜像内一致。
# ZEOKEEL_CHANNEL=official

# 主密钥(可选,强烈建议备份):留空则服务端首次启动自动生成 data/master.key
# ZEOKEEL_MASTER_KEY=

# 数据库连接池上限(留空 = 按实例数推导的默认;多实例/托管 PG 配额有限时下调)。
# ZEOKEEL_DB_MAX_OPEN_CONNS=25

# 启动期迁移执行器预算(**单位毫秒**,三个都留空 = 缺省 5min / 5min / 5s)。
# 运维口径(什么时候调、怎么读慢迁移告警)见 server/docs/06-database.md。
# ZEOKEEL_MIGRATION_LOCK_TIMEOUT_MS=600000
# ZEOKEEL_MIGRATION_ADVISORY_TIMEOUT_MS=600000
# ZEOKEEL_MIGRATION_SLOW_MS=5000

# 内置技能资产目录(缺省就是镜像内位置;换成宿主机目录时同时解开 compose 里的
# ./skills 挂载)。
# ZEOKEEL_SKILL_SEED_DIR=/opt/zeokeel/skills

# ------------------------------------------------------------
# ④ 已废除的部署开关(留着只会在启动日志告警,不生效)
#   具体键名与清理命令见 docs/deploy/AI-DEPLOY.md §2.5 —— 本文不再列出它们,
#   避免与本仓「旧模型残留」判据(A 桶零命中)冲突。
# ------------------------------------------------------------
